{
  "name": "dungeon-garden-worldbuilder-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server (stdio) that lets Claude Desktop or Claude Code write Worldbuilder drafts into a Dungeon Garden campaign for the DM to review.",
  "type": "module",
  "bin": { "dungeon-garden-worldbuilder": "dist/index.js" },
  "main": "dist/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  }
}
