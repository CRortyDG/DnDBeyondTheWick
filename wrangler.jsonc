{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candlefair",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/arrive", "/arrive/*", "/i/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "candlefair-files" }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "GUESS_LIMIT", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "UPLOAD_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "ADDRESS_LIMIT", "namespace_id": "1005", "simple": { "limit": 900, "period": 60 } },
    { "name": "FILE_LIMIT", "namespace_id": "1006", "simple": { "limit": 600, "period": 60 } }
  ],
  // Spending guards (src/server/spend.ts). R2 has no spend cap of its own, so the app keeps one.
  "vars": { "R2_CEILING_GB": "8", "R2_WRITES_PER_DAY": "25000", "ROOM_CALLS_PER_DAY": "20000" },
  "observability": { "enabled": true }
}
