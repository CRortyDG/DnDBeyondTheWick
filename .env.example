# Required: the DM's secret. Generate one with `npm run dm-key`.
DM_KEY=

# Upstash Redis (added automatically by the Vercel Marketplace integration).
# Either naming works. Leave blank locally to use a file store in .data/.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob (added automatically when you connect a Blob store).
# Leave blank locally to store uploads in .data/uploads.
BLOB_READ_WRITE_TOKEN=
